        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.educationalguide.org/ontologies/ontology.owl#isAptitudeOf -->

    <owl:ObjectProperty rdf:about="http://www.educationalguide.org/ontologies/ontology.owl#isAptitudeOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
