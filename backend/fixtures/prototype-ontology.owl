    </owl:ObjectProperty>
    


    <!-- http://www.educationalguide.org/ontologies/ontology.owl#hasInterest -->

    <owl:ObjectProperty rdf:about="http://www.educationalguide.org/ontologies/ontology.owl#hasInterest">
        <owl:inverseOf rdf:resource="http://www.educationalguide.org/ontologies/ontology.owl#isInterestOf"/>
