    <!-- http://www.educationalguide.org/ontologies/ontology.owl#hasAptitude -->

    <owl:ObjectProperty rdf:about="http://www.educationalguide.org/ontologies/ontology.owl#hasAptitude">
        <owl:inverseOf rdf:resource="http://www.educationalguide.org/ontologies/ontology.owl#isAptitudeOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.educationalguide.org/ontologies/ontology.owl#hasDegree -->

    <owl:ObjectProperty rdf:about="http://www.educationalguide.org/ontologies/ontology.owl#hasDegree">
        <owl:inverseOf rdf:resource="http://www.educationalguide.org/ontologies/ontology.owl#isDegreeOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.educationalguide.org/ontologies/ontology.owl#hasFaculty -->

    <owl:ObjectProperty rdf:about="http://www.educationalguide.org/ontologies/ontology.owl#hasFaculty">
