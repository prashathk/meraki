APP_ENV=development
AUTH_PROVIDER=development
# Generated locally by python -m scripts.configure_local. Never commit actual values.
DEMO_PASSWORD=
POSTGRES_PASSWORD=
DATABASE_URL=sqlite:///./data/meraki.db
LOCAL_STORAGE=data/objects
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Production: APP_ENV=production, AUTH_PROVIDER=firebase, PostgreSQL URL.
# Firebase uses Application Default Credentials on the backend.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Gemini Developer API: create a key from a project labelled Free Tier in AI Studio.
# Keep that project without billing. The model allowlist cannot verify billing tier.
# Backend only: never use a VITE_ variable for this key.
GEMINI_PROVIDER=developer
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Optional legacy cloud adapter: explicitly set GEMINI_PROVIDER=vertex and a model.
# Vertex AI is billed separately and is not the local free-tier configuration.
STORAGE_BUCKET=
# Optional trained spaCy NER model directory:
NER_MODEL_PATH=
