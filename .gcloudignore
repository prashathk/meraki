.gcloudignore
.git/
.venv/
.env
frontend/.env
frontend/node_modules/
frontend/dist/
**/__pycache__/
**/.pytest_cache/
frontend/test-results/
frontend/playwright-report/
infra/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
**/*.tfplan
data/
tmp/
output/

# Exclude environment variants and credential material from build uploads.
**/.env*
**/*.env
**/*.pem
**/*.key
**/*credentials*.json
**/*service-account*.json
**/*-firebase-adminsdk-*.json
**/*.tsbuildinfo
